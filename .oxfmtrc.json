{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 120,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "es5",
  "semi": false,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/coverage/**",
    "**/.turbo/**",
    "**/*.min.js",
    "**/yarn.lock",
    "**/storybook-static/**",
    "**/.contentlayer/**",
    "**/.git/**",
    "**/.changeset/**",
    "**/.husky/**",
    "**/.vscode/**",
    "**/.yarn/**",
    "**/.pnp.*",
    "**/*.tsbuildinfo",
    "**/public/sitemap.xml",
    "**/public/feed.xml"
  ]
}
