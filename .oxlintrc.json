{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "react", "react-perf", "jsx-a11y", "unicorn", "oxc"],
  "env": { "browser": true, "node": true, "es2024": true },
  "settings": {
    "react": { "version": "18.3.1" },
    "jsx-a11y": {
      "components": { "Link": "a" },
      "polymorphicPropName": "as"
    }
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/coverage/**",
    "**/.turbo/**",
    "**/*.min.js",
    "**/yarn.lock",
    "**/storybook-static/**",
    "**/.contentlayer/**",
    "**/.git/**",
    "**/.changeset/**",
    "**/.husky/**",
    "**/.vscode/**",
    "**/.yarn/**",
    "**/.pnp.*",
    "**/*.tsbuildinfo"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "off",
    "perf": "warn",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "import/no-unassigned-import": "off",
    "react/react-in-jsx-scope": "off",
    "react-perf/jsx-no-jsx-as-prop": "off",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "react-perf/jsx-no-new-array-as-prop": "off",
    "typescript/no-explicit-any": "warn",
    "typescript/no-floating-promises": "error",
    "typescript/consistent-type-imports": ["warn", { "prefer": "type-imports", "fixStyle": "inline-type-imports" }],
    "typescript/no-unused-vars": [
      "warn",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_" }
    ],
    "typescript/no-extraneous-class": "warn",
    "no-shadow": "warn",
    "no-underscore-dangle": "warn",
    "unicorn/no-array-sort": "warn",
    "unicorn/consistent-function-scoping": "warn",
    "unicorn/no-array-for-each": "off",
    "unicorn/numeric-separators-style": "off",
    "unicorn/prefer-global-this": "off",
    "unicorn/filename-case": "off",
    "no-console": ["warn", { "allow": ["warn", "error"] }]
  },
  "overrides": [
    {
      "files": ["**/*.{spec,test}.{js,mjs,cjs,ts,mts,cts,tsx}", "**/__tests__/**/*", "**/test/**/*"],
      "plugins": ["vitest"],
      "rules": {
        "no-console": "off",
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": [
        "**/scripts/**/*",
        "**/*.{config,setup}.{js,mjs,cjs,ts}",
        "**/rollup.config.*",
        "**/tsup.config.*",
        "**/postcss.config.*",
        "**/next.config.*",
        "**/storybook/**/*"
      ],
      "rules": { "no-console": "off" }
    },
    {
      "files": ["apps/stories/**/*", "**/*.stories.{ts,tsx}", "**/*.mdx"],
      "rules": {
        "import/no-unassigned-import": "off",
        "typescript/no-explicit-any": "off"
      }
    }
  ]
}
